{
  "name": "autoreboque-tora-angular",
  "version": "1.0.0",
  "description": "Frontend Angular para ERP Auto Reboque Torá integrado ao backend Spring Boot JWT.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "security:audit": "set NODE_OPTIONS=--use-system-ca&& npm audit --omit=dev --audit-level=moderate"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.0",
    "@angular/common": "22.1.0",
    "@angular/compiler": "22.1.0",
    "@angular/core": "22.1.0",
    "@angular/forms": "22.1.0",
    "@angular/platform-browser": "22.1.0",
    "@angular/platform-browser-dynamic": "22.1.0",
    "@angular/router": "22.1.0",
    "chart.js": "^4.5.1",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.3",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular/build": "22.1.2",
    "@angular/cli": "22.1.2",
    "@angular/compiler-cli": "22.1.0",
    "typescript": "6.0.3"
  }
}
